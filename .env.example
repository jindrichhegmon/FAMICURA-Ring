# SQL Server CLB1 – tabulky dbo.FamicuraRingLog a dbo.FamicuraRingNahravky (zakládá sql/clb1.sql).
# Aplikace do nich pouze zapisuje. Stejné hodnoty jako /opt/pecedoma-sestra/.env
SQL_SERVER=90.182.39.103
SQL_PORT=1433
SQL_DATABASE=CLB1
SQL_USER=clb1_app
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
SQL_TIMEOUT_MS=30000

# Stejná hodnota jako proměnná RING_HMAC_KEY v Netlify – ověřuje se jí přihlašovací cookie.
RING_HMAC_KEY=

# Samostatný server (server.mjs na VPS): port a adresa za reverse proxy (Caddy)
PORT=3101
HOST=127.0.0.1
TZ=Europe/Prague

# Volitelně omezení původu; prázdné = *
CORS_ORIGIN=https://famicura-ring.netlify.app
